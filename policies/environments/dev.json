{
  "$schema": "./environment.schema.json",
  "description": "Dev subscription. Policies audit only (enforcementMode DoNotEnforce) so nothing is blocked while rules are tried out.",
  "pacOwnerId": "azure-policy-as-code-dev",
  "deploymentScope": "/subscriptions/${env:POLICY_SUBSCRIPTION_ID}",
  "managedIdentityLocation": "australiaeast",
  "tokens": {
    "allowedLocations": [ "australiaeast", "australiasoutheast", "westus2" ],
    "requiredTagName": "costCentre",
    "enforcementMode": "DoNotEnforce"
  }
}
